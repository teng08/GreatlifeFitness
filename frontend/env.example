# Optional: set full API base URL (e.g. https://api.example.com/api)
# If omitted, frontend uses /api and Next.js rewrites it to BACKEND_ORIGIN.
NEXT_PUBLIC_API_URL=

# Backend origin used by next.config.ts rewrite for /api/* requests
BACKEND_ORIGIN=http://localhost:5000

# Browser fallback used when EmailJS server-side API access is disabled.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
